{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Konfiguracja zamówienia mapowego v2",
  "description": "Jeden obiekt na zamówienie: epic albo samodzielne zgłoszenie nowego zamówienia, nie na każdy ticket. Kandydat do oceny, nie zgoda na uruchomienie. Każde null wymaga konkretnego powodu.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "region",
    "area_name",
    "bbox",
    "layers",
    "data_release",
    "start_step",
    "steps",
    "output_format",
    "output_path",
    "deadline",
    "requester_team",
    "notes",
    "unknown_reasons"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "area_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "bbox": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "description": "EPSG:4326, west,south,east,north. Null także dla jawnego braku wycinka, z powodem."
    },
    "layers": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "roads",
          "junctions",
          "poi",
          "speed_limits",
          "addresses"
        ]
      }
    },
    "data_release": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^20[0-9]{2}\\.(0[1-9]|1[0-2])$"
    },
    "start_step": {
      "enum": [
        "ingest",
        "conflation",
        "validation",
        "export",
        "publish",
        null
      ]
    },
    "steps": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ingest",
          "conflation",
          "validation",
          "export",
          "publish"
        ]
      }
    },
    "output_format": {
      "enum": [
        "parquet",
        "geojson",
        "delta",
        "csv",
        "gpkg",
        null
      ]
    },
    "output_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "date"
    },
    "requester_team": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknown_reasons": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "region",
          "area_name",
          "bbox",
          "layers",
          "data_release",
          "start_step",
          "steps",
          "output_format",
          "output_path",
          "deadline",
          "requester_team",
          "notes"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "region": {
            "type": "null"
          }
        },
        "required": [
          "region"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "region"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "area_name": {
            "type": "null"
          }
        },
        "required": [
          "area_name"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "area_name"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bbox": {
            "type": "null"
          }
        },
        "required": [
          "bbox"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "bbox"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layers": {
            "type": "null"
          }
        },
        "required": [
          "layers"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "layers"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_release": {
            "type": "null"
          }
        },
        "required": [
          "data_release"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "data_release"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "start_step": {
            "type": "null"
          }
        },
        "required": [
          "start_step"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "start_step"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "steps": {
            "type": "null"
          }
        },
        "required": [
          "steps"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "steps"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_format": {
            "type": "null"
          }
        },
        "required": [
          "output_format"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "output_format"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_path": {
            "type": "null"
          }
        },
        "required": [
          "output_path"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "output_path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deadline": {
            "type": "null"
          }
        },
        "required": [
          "deadline"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "deadline"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requester_team": {
            "type": "null"
          }
        },
        "required": [
          "requester_team"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "requester_team"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "notes": {
            "type": "null"
          }
        },
        "required": [
          "notes"
        ]
      },
      "then": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "notes"
            ]
          }
        }
      }
    }
  ]
}
